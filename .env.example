# ── Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins (the frontend dev server)
CORS_ORIGIN=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/weightcalc?schema=public

# ── JWT secrets (use long random strings; rotate per environment) ────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
# Issued to a user who has verified an OTP but not yet set a PIN
JWT_INITIATION_SECRET=change-me-initiation-secret-min-32-chars

# ── Resend (transactional email) ─────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="WeightCalc <auth@yourdomain.com>"
